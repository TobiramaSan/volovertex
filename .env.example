# ─────────────────────────────────────────────────────────────────────────────
# Client config — BAKED INTO THE PUBLIC BUNDLE.
#
# Vite inlines every VITE_* variable into the JavaScript it ships, so anything
# prefixed VITE_ is readable by anyone who opens the site. Never put a token,
# key or connection string behind a VITE_ name.
# ─────────────────────────────────────────────────────────────────────────────

# Where the journey request form POSTs. Same origin, so no CORS and no secret.
# Leave it unset and the form warns in the console instead of silently dropping
# the lead — it does not pretend the request was saved.
VITE_REQUEST_ENDPOINT=/api/journey-requests


# ─────────────────────────────────────────────────────────────────────────────
# Server config — set these in your host's dashboard, never in a committed
# file. No VITE_ prefix, so they stay server-side.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres. Apply db/schema.sql once before the first request.
DATABASE_URL=

# Telegram alerts. Create a bot with @BotFather for the token, add it to your
# team group, then read the group's id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp alerts (optional; Telegram alone is enough to be notified).
#
# Read this before registering a number: a number registered to the Cloud API
# can NO LONGER be used in the WhatsApp Business app, and migrating it directly
# loses its chat history. Keep the number printed on the site in the app where a
# human reads it, and register a SECOND number as the sender below.
#
# The alert is business-initiated, so it must be a pre-approved template and is
# billed per message. The template needs five body placeholders in this order:
#   {{1}} name  {{2}} journey type  {{3}} date  {{4}} route  {{5}} phone
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Comma-separated staff numbers in international format, e.g. 2348062253944
WHATSAPP_ALERT_RECIPIENTS=
# Override only if you need a different Graph API version.
WHATSAPP_GRAPH_VERSION=v23.0

# ── Rate limiting ────────────────────────────────────────────────────────────
# The request endpoint is public, and every WhatsApp template send is billed, so
# a flood costs money. Two limits guard it, both held in Postgres (no extra
# service needed). Defaults are shown; all are optional.
#
# Keep the per-IP limit generous: Nigerian mobile networks use carrier-grade
# NAT, so one address can legitimately be many travellers. The global cap is
# what actually bounds the bill.
RATE_LIMIT_PER_IP_MAX=10
RATE_LIMIT_PER_IP_WINDOW_SECONDS=600
RATE_LIMIT_GLOBAL_MAX=120
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=3600
# Any non-empty string. Addresses are stored as a salted digest, never raw.
RATE_LIMIT_SALT=
